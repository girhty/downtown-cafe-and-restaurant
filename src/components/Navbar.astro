---
const phone = "0774 500 2020";
const address = "البصرة - الجزائر مقابل محطة وقود الجزائر";
---

<header class="fixed top-0 left-0 right-0 z-40 transition-all duration-300 backdrop-blur-md bg-downtown-dark/80 border-b border-downtown-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo & Identity -->
      <a href="#home" class="flex items-center gap-3 group">
        <div class="w-12 h-12 rounded-full border border-downtown-gold/40 p-0.5 shadow-lg shadow-downtown-gold/10 group-hover:border-downtown-gold transition-all duration-300">
          <div class="w-full h-full rounded-full bg-gradient-to-tr from-downtown-card to-downtown-surface flex items-center justify-center font-serif text-downtown-gold font-bold text-xl">
            DT
          </div>
        </div>
        <div class="text-right">
          <span class="block text-xl font-bold tracking-tight text-white font-serif group-hover:text-downtown-gold transition-colors">
            DownTown
          </span>
          <span class="block text-xs font-semibold text-downtown-gold tracking-widest uppercase">
            داون تاون • كافيه ومطعم
          </span>
        </div>
      </a>

      <!-- Quick Nav Links -->
      <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
        <a href="#about" class="hover:text-downtown-gold transition-colors">عن المطعم</a>
        <a href="#experience" class="hover:text-downtown-gold transition-colors">التجربة والخدمة</a>
        <a href="#gallery" class="hover:text-downtown-gold transition-colors">معرض الصور</a>
        <a href="#instagram" class="hover:text-downtown-gold transition-colors">منشورات انستغرام</a>
        <a href="#reviews" class="hover:text-downtown-gold transition-colors">تقييمات الضيوف</a>
        <a href="#location" class="hover:text-downtown-gold transition-colors">الموقع والتواصل</a>
      </nav>

      <!-- Action Button -->
      <div class="flex items-center gap-3">
        <a 
          href={`tel:${phone.replace(/\s+/g, '')}`} 
          class="hidden sm:inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-downtown-gold/50 bg-downtown-gold/10 text-downtown-gold text-sm font-semibold hover:bg-downtown-gold hover:text-black transition-all duration-300 shadow-md shadow-downtown-gold/5"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>احجز طاولتك</span>
        </a>

        <a 
          href="https://www.instagram.com/down.town.basra" 
          target="_blank" 
          rel="noopener noreferrer"
          class="p-2.5 rounded-full bg-downtown-card border border-downtown-border hover:border-pink-500/50 hover:text-pink-400 transition-colors"
          aria-label="Instagram"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</header>
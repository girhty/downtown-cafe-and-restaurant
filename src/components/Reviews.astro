---
const reviews = [
  {
    name: "Elaf Ali",
    rating: 5,
    tag: "زبون موثق",
    comment: "It is one of the most beautiful and elegant restaurants within this area. Great atmosphere and excellent customer service 👌🏻 من أرقى وأجمل المطاعم في البصرة بدون منازع."
  },
  {
    name: "Ghada Kamel",
    rating: 5,
    tag: "تجربة طعام ممتازة",
    comment: "The decoration is very elegant, the service is great, the food is excellent and the staff is super friendly, the prices are very good considering the setting and the quality of the food."
  },
  {
    name: "Hussein Al-Saeed",
    rating: 4,
    tag: "مقيم محلي",
    comment: "This is a good restaurant 👌 and the customer service is good 👍. Nice atmosphere and special interior decoration ✨️ التصميم والديكور الداخلي استثنائي وأجواء ممتعة جداً."
  }
];
---

<section id="reviews" class="py-24 bg-downtown-surface/60 border-t border-downtown-border relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
      <span class="text-xs font-bold text-downtown-gold uppercase tracking-widest font-serif block">
        Verified Reviews
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white">ماذا يقول ضيوف داون تاون؟</h2>
      <p class="text-slate-400 text-sm">
        تقييمات حقيقية من ضيوفنا الكرام على خرائط Google مع تقييم عام 4.0 نجوم من أكثر من 350 زائر
      </p>
    </div>

    <!-- Review Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {reviews.map((rev) => (
        <div class="bg-downtown-card/90 border border-downtown-border hover:border-downtown-gold/40 p-8 rounded-3xl flex flex-col justify-between shadow-xl transition-all duration-300 hover:-translate-y-1">
          <div>
            <!-- Stars -->
            <div class="flex items-center gap-1 text-amber-400 mb-4">
              {Array.from({ length: rev.rating }).map(() => (
                <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>

            <!-- Quote Text -->
            <p class="text-slate-300 text-sm leading-relaxed mb-6 italic">
              "{rev.comment}"
            </p>
          </div>

          <!-- Author Info -->
          <div class="flex items-center gap-3 pt-4 border-t border-white/5">
            <div class="w-10 h-10 rounded-full bg-downtown-gold/20 text-downtown-gold font-bold flex items-center justify-center text-sm">
              {rev.name.charAt(0)}
            </div>
            <div>
              <h4 class="text-sm font-bold text-white">{rev.name}</h4>
              <span class="text-xs text-downtown-gold">{rev.tag}</span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Google Banner Counter -->
    <div class="mt-14 p-6 rounded-2xl bg-downtown-dark border border-downtown-border flex flex-wrap items-center justify-between gap-4 text-center sm:text-right">
      <div class="flex items-center gap-3 mx-auto sm:mx-0">
        <div class="w-10 h-10 rounded-xl bg-white flex items-center justify-center font-bold text-slate-900 shadow">
          G
        </div>
        <div>
          <span class="block text-sm font-bold text-white">Google Places Rating</span>
          <span class="text-xs text-slate-400">تقييم موثق لفرع البصرة الرسمي</span>
        </div>
      </div>

      <div class="flex items-center gap-2 mx-auto sm:mx-0">
        <span class="text-2xl font-bold text-amber-400">4.0 / 5.0</span>
        <span class="text-xs text-slate-400">استناداً إلى 356 مراجعة معتمدة</span>
      </div>
    </div>

  </div>
</section>
---

<section id="gallery" class="py-24 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
      <div class="text-right">
        <span class="text-xs font-bold text-downtown-gold uppercase tracking-widest font-serif block mb-2">Visual Tour</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white">معرض أجواء داون تاون</h2>
        <p class="text-slate-400 text-sm mt-2">صور حصرية من داخل الصالة والمطعم الأكبر في البصرة</p>
      </div>

      <div class="inline-flex items-center gap-2 self-start md:self-auto px-4 py-2 rounded-full bg-downtown-card border border-downtown-border text-xs text-slate-300">
        <span class="w-2 h-2 rounded-full bg-downtown-gold"></span>
        موثق عبر Google Maps & Guests
      </div>
    </div>

    <!-- Bento Gallery Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-4 auto-rows-[220px]">
      {photos.map((item) => (
        <div class={`relative group overflow-hidden rounded-3xl border border-downtown-border/80 bg-downtown-card ${item.span}`}>
          <img 
            src={item.src} 
            alt={item.alt}
            class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent opacity-80 group-hover:opacity-90 transition-opacity"></div>
          
          <div class="absolute bottom-4 right-4 left-4 flex items-center justify-between pointer-events-none">
            <span class="px-3 py-1 rounded-full text-xs font-semibold bg-black/60 backdrop-blur-md text-downtown-gold border border-white/10">
              {item.tag}
            </span>
            <span class="text-white/80 text-xs font-serif opacity-0 group-hover:opacity-100 transition-opacity">
              DownTown
            </span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
---
const phone1 = "0774 500 2020";
const phone2 = "0784 500 2020";
const address = "البصرة - الجزائر مقابل محطة وقود الجزائر";
const mapsCode = "GR5F+R52, Basrah, Basra Governorate";
---

<section id="location" class="py-24 relative bg-downtown-dark">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-stretch">
      
      <!-- Info Column -->
      <div class="lg:col-span-5 bg-downtown-card p-8 md:p-10 rounded-3xl border border-downtown-border flex flex-col justify-between">
        <div class="space-y-6">
          <div class="space-y-2">
            <span class="text-xs font-bold text-downtown-gold uppercase tracking-widest font-serif">Visit & Reserve</span>
            <h2 class="text-3xl font-extrabold text-white">أهلاً وسهلاً بكم في داون تاون</h2>
            <p class="text-sm text-slate-400 leading-relaxed">
              يسعدنا استقبالكم وعائلاتكم الكريمة للاستمتاع بأرقى الأوقات وأشهى الوجبات في موقعنا المميز بمنطقة الجزائر.
            </p>
          </div>

          <!-- Contact items list -->
          <div class="space-y-4 pt-2">
            
            <div class="flex items-start gap-4 p-4 rounded-2xl bg-downtown-surface/80 border border-white/5">
              <div class="p-2.5 rounded-xl bg-downtown-gold/10 text-downtown-gold shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <span class="block text-xs text-slate-400 mb-0.5">العنوان المباشر:</span>
                <span class="text-sm font-bold text-white block">{address}</span>
                <span class="text-[11px] text-downtown-gold mt-1 block">Plus Code: {mapsCode}</span>
              </div>
            </div>

            <div class="flex items-start gap-4 p-4 rounded-2xl bg-downtown-surface/80 border border-white/5">
              <div class="p-2.5 rounded-xl bg-downtown-gold/10 text-downtown-gold shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div class="w-full">
                <span class="block text-xs text-slate-400 mb-0.5">أرقام الحجز والاستفسار:</span>
                <div class="flex flex-col sm:flex-row gap-3 mt-1">
                  <a href={`tel:${phone1.replace(/\s+/g, '')}`} class="text-sm font-bold text-downtown-gold-light hover:underline direction-ltr">
                    {phone1}
                  </a>
                  <span class="hidden sm:inline text-slate-600">|</span>
                  <a href={`tel:${phone2.replace(/\s+/g, '')}`} class="text-sm font-bold text-downtown-gold-light hover:underline direction-ltr">
                    {phone2}
                  </a>
                </div>
              </div>
            </div>

            <div class="flex items-start gap-4 p-4 rounded-2xl bg-downtown-surface/80 border border-white/5">
              <div class="p-2.5 rounded-xl bg-emerald-500/10 text-emerald-400 shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div>
                <span class="block text-xs text-slate-400 mb-0.5">ساعات العمل:</span>
                <span class="text-sm font-bold text-white block">مفتوح يومياً (صباحاً ومساءً)</span>
                <span class="text-[11px] text-emerald-400 font-semibold block mt-1">نستقبلكم للفطور والغداء والعشاء</span>
              </div>
            </div>

          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-white/10 flex items-center justify-between">
          <span class="text-xs text-slate-400">تابعونا على مواقع التواصل</span>
          <a 
            href="https://www.instagram.com/down.town.basra" 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-xs font-bold text-downtown-gold hover:text-white transition-colors"
          >
            Instagram: @down.town.basra ↗
          </a>
        </div>
      </div>

      <!-- Interactive Map / Visual Placement Card -->
      <div class="lg:col-span-7 bg-downtown-surface rounded-3xl border border-downtown-border overflow-hidden relative min-h-[420px] flex flex-col">
        <!-- Map header toolbar -->
        <div class="p-4 bg-downtown-card/90 border-b border-downtown-border flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-red-500 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-amber-500 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-500 inline-block"></span>
            <span class="text-xs font-semibold text-slate-300 mr-2">خريطة الموقع - داون تاون البصرة</span>
          </div>

          <a 
            href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent("DownTown Café and Restaurant Basra")}`}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs text-downtown-gold hover:underline flex items-center gap-1 font-semibold"
          >
            <span>فتح في Google Maps</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>

        <!-- Styled visual map simulation / embed container -->
        <div class="relative flex-1 w-full bg-[#15151c] flex items-center justify-center p-6 text-center">
          <div class="space-y-4 max-w-md">
            <div class="w-16 h-16 rounded-full bg-downtown-gold/15 border border-downtown-gold/40 text-downtown-gold flex items-center justify-center mx-auto shadow-2xl animate-bounce">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            
            <h3 class="text-xl font-bold text-white">DownTown Café and Restaurant</h3>
            <p class="text-xs text-slate-400">
              البصرة - الجزائر مقابل محطة وقود الجزائر <br/>
              رمز الموقع العالمي: <code class="text-downtown-gold font-mono">GR5F+R52</code>
            </p>

            <a 
              href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent("GR5F+R52, Basrah, Basra Governorate")}`}
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-downtown-gold hover:bg-downtown-gold-light text-slate-950 font-bold text-sm transition-all shadow-lg shadow-downtown-gold/10"
            >
              <span>احصل على الاتجاهات مباشرة</span>
              <svg class="w-4 h-4 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </a>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>